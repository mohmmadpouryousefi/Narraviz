generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Extensionless imports so Next.js (webpack) resolves the generated .ts files.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js models (field names required by @auth/prisma-adapter) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// scrypt hash for email/password sign-in; null for OAuth-only users
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  datasets Dataset[]
  stories  Story[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- App models ----------

model Dataset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  rowCount  Int
  /// ColumnMeta[]
  columns   Json
  /// DataRow[]; never selected in list queries because it can be several MB
  rows      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories Story[]

  @@index([userId, createdAt])
}

enum StoryStatus {
  draft
  published
}

model Story {
  id              String      @id @default(cuid())
  userId          String
  datasetId       String
  title           String
  description     String      @default("")
  status          StoryStatus @default(draft)
  /// StoryBlock[]
  blocks          Json        @default("[]")
  /// "ai" | "stats" | null
  narrativeSource String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([datasetId])
}
