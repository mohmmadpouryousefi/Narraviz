# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/narraviz"

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Optional: GitHub sign-in. Create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: AI narratives. Without it, stories use the stats-only narrative.
ANTHROPIC_API_KEY=""
